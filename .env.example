# Copy this file to .env.local and fill in the values you need.
# Every variable is optional except the ones your setup actually uses.

# ===== LLM (OpenAI-compatible endpoint) =====
# Must be reachable from wherever the app runs. Do not use 127.0.0.1 if the app is on a VPS.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 0 disables every LLM call. Checklists stay manual, news and the opportunity radar still work from group messages.
LLM_ENABLED=1
# Hard cap on LLM calls per day, keeps the bill predictable.
LLM_DAILY_BUDGET=40
# Optional. Comma separated model list for the endpoint above, used instead of LLM_MODEL when you want
# the app to rotate over several models on the same endpoint.
# Example: LLM_MODELS=vendor/model-a,vendor/model-b
LLM_MODELS=
# Optional. Models on that endpoint which can read images, for screenshots you paste into a task.
# Leave empty and the text list handles everything.
LLM_VISION_MODELS=
# Optional. Comma separated models that need reasoning switched off explicitly. Some self-hosted
# servers spend the whole token budget on hidden thinking and return an empty answer without this.
LLM_NO_THINK=

# ===== Optional extra providers (fallback, all of them are optional) =====
# Order the app tries them in: OpenRouter, then Gemini, then the endpoint above. The provider that
# answers is reused until it starts failing, then the app moves to the next one. Fill in what you have.
# OpenRouter: key from openrouter.ai/keys. The ":free" models cost nothing.
OPENROUTER_API_KEY=
# Example: OPENROUTER_TEXT_MODELS=vendor/model-a:free,vendor/model-b:free
OPENROUTER_TEXT_MODELS=
OPENROUTER_VISION_MODELS=
# Google AI Studio key, free tier. Talks to Gemini through its OpenAI-compatible endpoint.
GEMINI_API_KEY=
# Example: GEMINI_TEXT_MODELS=gemini-2.5-flash
GEMINI_TEXT_MODELS=
GEMINI_VISION_MODELS=

# ===== Telegram bot (notifications) =====
# Bot token from @BotFather. For the chat id, send /start to the bot and read getUpdates, or ask @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Telegram userbot (reads the groups you joined) =====
# api_id and api_hash from my.telegram.org, using your own Telegram account.
TG_API_ID=
TG_API_HASH=

# ===== On-chain checks =====
# Etherscan V2 API key, free, one key covers every EVM chain.
ETHERSCAN_API_KEY=
# Optional. Defaults to the public Solana mainnet RPC.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ===== Security (required if the app is reachable from the internet or a VPS) =====
# Web login PIN. Empty means no login at all, which is only acceptable on localhost.
APP_PIN=
# Bearer token for an external scheduler that calls /api/cron/news. Optional, the built-in scheduler already runs.
CRON_TOKEN=

# ===== Server =====
PORT=3111
TZ=Asia/Jakarta

# ===== Extra news feeds (optional) =====
# Comma separated RSS or Atom feeds. Example: NEWS_FEEDS=https://example.com/feed.xml
NEWS_FEEDS=

# Copy this file to .env.local and fill in the values you need.
# Every variable is optional except the ones your setup actually uses.

# ===== LLM (OpenAI-compatible endpoint) =====
# Must be reachable from wherever the app runs. Do not use 127.0.0.1 if the app is on a VPS.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 0 disables every LLM call. Checklists stay manual, news and the opportunity radar still work from group messages.
LLM_ENABLED=1
# Hard cap on LLM calls per day, keeps the bill predictable.
LLM_DAILY_BUDGET=40

# ===== Telegram bot (notifications) =====
# Bot token from @BotFather. For the chat id, send /start to the bot and read getUpdates, or ask @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Telegram userbot (reads the groups you joined) =====
# api_id and api_hash from my.telegram.org, using your own Telegram account.
TG_API_ID=
TG_API_HASH=

# ===== On-chain checks =====
# Etherscan V2 API key, free, one key covers every EVM chain.
ETHERSCAN_API_KEY=
# Optional. Defaults to the public Solana mainnet RPC.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ===== Security (required if the app is reachable from the internet or a VPS) =====
# Web login PIN. Empty means no login at all, which is only acceptable on localhost.
APP_PIN=
# Bearer token for an external scheduler that calls /api/cron/news. Optional, the built-in scheduler already runs.
CRON_TOKEN=

# ===== Server =====
PORT=3111
TZ=Asia/Jakarta

# ===== Extra news feeds (optional) =====
# Comma separated RSS or Atom feeds. Example: NEWS_FEEDS=https://example.com/feed.xml
NEWS_FEEDS=
